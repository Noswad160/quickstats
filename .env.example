# Claude
ANTHROPIC_API_KEY=sk-ant-...
# claude-haiku-5-5 is faster and much cheaper per minute
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Twilio (console.twilio.com)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# the number your carrier forwards to
TWILIO_NUMBER=+1...
PUBLIC_URL=https://your-app.example.com
# optional; Twilio's default voice is used otherwise
# TTS_PROVIDER=ElevenLabs
# TTS_VOICE=...

# You
# only the message-taker says this; the time-wasters never do
OWNER_NAME=Dawson
# gets a text when a real caller leaves a message
OWNER_MOBILE=+1...
# always get the message-taker, never a time-waster
ALLOWLIST=+15015550123,+15015550124

# Limits
MAX_CALL_MINUTES=30
DAILY_MINUTES_CAP=180

# earl | linda | gerald
PERSONA=earl
SAVE_TRANSCRIPTS=true
DB_PATH=data/spambot.sqlite
# for GET /calls
ADMIN_TOKEN=change-me
# local testing only: skip Twilio signature checks
# ALLOW_UNSIGNED=1
